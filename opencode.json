{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "backend-developer": {
            "description": "Backend developer specializing in APIs, server logic, authentication, and service architecture",
            "mode": "subagent",
            "prompt": "{file:.claude/agents/backend-developer.md}",
            "tools": {
                "Read": true,
                "Write": true,
                "Edit": true,
                "Bash": true,
                "Glob": true,
                "Grep": true
            }
        },
        "frontend-developer": {
            "description": "Frontend developer specializing in React, TypeScript, UI/UX implementation, and web performance",
            "mode": "subagent",
            "prompt": "{file:.claude/agents/frontend-developer.md}",
            "tools": {
                "Read": true,
                "Write": true,
                "Edit": true,
                "Bash": true,
                "Glob": true,
                "Grep": true
            }
        },
        "database-manager": {
            "description": "Database architect and manager handling schema design, migrations, queries, indexing, and data modeling",
            "mode": "subagent",
            "prompt": "{file:.claude/agents/database-manager.md}",
            "tools": {
                "Read": true,
                "Write": true,
                "Edit": true,
                "Bash": true,
                "Glob": true,
                "Grep": true
            }
        },
        "code-reviewer": {
            "description": "Code reviewer that analyzes code quality, best practices, potential bugs, and provides constructive feedback",
            "mode": "subagent",
            "prompt": "{file:.claude/agents/code-reviewer.md}",
            "tools": {
                "Read": true,
                "Glob": true,
                "Grep": true,
                "Bash": true
            }
        },
        "project-manager": {
            "description": "Project manager that translates OpenSpec proposals into tasks, assigns work, tracks progress, and manages sprints",
            "mode": "subagent",
            "prompt": "{file:.claude/agents/project-manager.md}",
            "tools": {
                "Read": true,
                "Glob": true,
                "Grep": true
            }
        },
        "graphical-designer": {
            "description": "Visual/graphical designer handling UI design, wireframes, mockups, design tokens, and component specifications",
            "mode": "subagent",
            "prompt": "{file:.claude/agents/graphical-designer.md}",
            "tools": {
                "Read": true,
                "Write": true,
                "Edit": true,
                "Bash": true,
                "Glob": true,
                "Grep": true,
                "mcp__pencil__*": true
            }
        }
    }
}
